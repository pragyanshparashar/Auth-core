<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class=" w-full h-screen bg-zinc-900 text-white p-10">
        <h1 class="text-3xl mb-3">Create A User</h1> 
        <form method="post" action="/create">
            <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 " type="text" placeholder="Username" name="username" >
            <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" placeholder="email" name="email">
            <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" placeholder="Password" name="password">
            <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" type="number" placeholder="Age" name="age">
            <input class="px-4 py-2 rounded-md bg-blue-500" type="submit" value="Create User">
        </form>
        
    </div>
    
</body>
</html>